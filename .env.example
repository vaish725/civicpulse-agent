# Copy this file to .env and fill in real values. .env is gitignored and
# never committed; this example file is, as a template only.

# Only needed when MODEL_PROVIDER=anthropic (see config.py and the README
# for why this alternate path exists: an AWS-account-level Bedrock access
# issue, independent of anything in this project's code).
ANTHROPIC_API_KEY=

# "bedrock" (default) or "anthropic". Leave unset or blank to use Bedrock.
MODEL_PROVIDER=
